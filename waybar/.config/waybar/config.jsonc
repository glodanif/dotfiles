{
  // Dead on waybar 0.15 here: the file monitor registers no watch (waybar's
  // only inotify fd has zero wds), so style edits need `pkill -USR2 waybar`.
  // "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 4,
  "modules-left": ["custom/artix", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock", "custom/weather"],
  "modules-right": [
    "custom/screenshare",
    "custom/mic",
    "tray",
    "custom/layout",
    "custom/recording",
    "custom/updates",
    "custom/maintenance",
    "cpu",
    "memory",
    "pulseaudio",
    "bluetooth",
    "custom/vpn",
    "network",
    "custom/notification",
  ],
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:L%A %H:%M}",
    "format-alt": "{:L%d %B W%V %Y}",
    "on-click-right": "ghostty -e calcurse",
  },
  "cpu": {
    "format": " {usage}%",
    "on-click": "ghostty -e btop",
  },
  "memory": {
    "format": " {}%",
    "on-click": "ghostty -e btop",
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-wifi": "{icon}",
    "format-ethernet": "󰈁",
    "format-disconnected": "?",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "interface": "eth*",
    "on-click": "run-and-wait nmtui",
    "on-click-right": "run-and-wait speedtest-cli",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphone": "",
      "headset": "",
    },
    "scroll-step": 5,
    "on-click": "ghostty -e wiremix",
  },
  "bluetooth": {
    "format": "",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "󰂲",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueman-manager",
  },
  "tray": {
    "spacing": 10,
  },
  "custom/layout": {
    "exec": "layout-watch",
    "return-type": "json",
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    // "activate" still shells the legacy `dispatch workspace N`, which the Lua
    // config rejects, so clicking a number is dead until Waybar learns the Lua
    // form. Scrolling over the module works instead (side buttons don't — the
    // per-workspace GtkButton eats the press). Hyprland's relative selectors are
    // no good here: "e±1" skips the empty slots and "r±1" runs off past 7 into a
    // ws8 no rule in windows.lua places, so step the id by hand and clamp to 1-7.
    "on-scroll-up": "w=$(hyprctl activeworkspace -j | jq -r .id); [ \"$w\" -gt 1 ] && [ \"$w\" -le 7 ] && hyprctl dispatch \"hl.dsp.focus({ workspace = $((w-1)) })\"",
    "on-scroll-down": "w=$(hyprctl activeworkspace -j | jq -r .id); [ \"$w\" -ge 1 ] && [ \"$w\" -lt 7 ] && hyprctl dispatch \"hl.dsp.focus({ workspace = $((w+1)) })\"",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
    },
  },
  "hyprland/window": {
    "format": "{}",
    "format-empty": "",
    "separate-outputs": true,
    "rewrite": {
      "^(.{40}).+": "[ $1... ]",
      "^(.{1,40})$": "[ $1 ]",
      "^$": "",
    },
    "on-click-middle": "hyprctl dispatch 'hl.dsp.window.close()'",
  },
  "custom/weather": {
    "exec": "terminal-weather -w",
    "on-click": "run-and-wait terminal-weather",
    "return-type": "json",
    "interval": 900,
  },
  "custom/updates": {
    "exec": "[ -s $HOME/.cache/scripts/waybar-updates-cache ] && cat $HOME/.cache/scripts/waybar-updates-cache || echo '{\"text\":\"\"}'",
    "return-type": "json",
    "interval": "once",
    "on-click": "run-and-wait sys-update",
    "on-click-middle": "rm -f $HOME/.cache/scripts/waybar-updates-cache && pkill -RTMIN+8 waybar",
    "signal": 8,
  },
  "custom/maintenance": {
    "exec": "maintenance-watch",
    "return-type": "json",
    "interval": 3600,
    "on-click": "run-and-wait sys-maintenance",
    "signal": 8,
  },
  "custom/artix": {
    "exec": "echo ' '",
    "interval": "once",
    "format": "{}",
    "tooltip-format": "Artix Menu",
    "on-click": "walker --provider menus:main",
  },
  "custom/mic": {
    "exec": "mic-watch",
    "return-type": "json",
    "on-click": "mic-toggle",
  },
  "custom/recording": {
    "exec": "echo '{\"text\": \"⏺\", \"class\": \"recording\"}'",
    "exec-if": "[ -f /tmp/ongoing-screenrecording ]",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "screenrecord off",
  },
  "custom/screenshare": {
    "exec": "screenshare-watch",
    "return-type": "json",
  },
  "custom/vpn": {
    "exec": "vpn-status",
    "interval": "once",
    "signal": 8,
    "return-type": "json",
    "on-click": "run-and-wait vpn-run off",
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
}
