#!/bin/zsh
STATE_FILE="/tmp/hypr-display-mode"
PERSISTENT_WORKSPACES=7

MODE=$1
SKIP_MONITORS=0
[ "$2" = "--skip-monitors" ] && SKIP_MONITORS=1

if [ -z "$MODE" ]; then
    CURRENT=$(cat "$STATE_FILE" 2>/dev/null || echo "pc")
    if [ "$CURRENT" = "pc" ]; then
        MODE="tv"
    else
        MODE="pc"
    fi
fi

set_sink() {
    local prefix=$1
    local attempts=10
    for ((i=1; i<=attempts; i++)); do
        local sink
        sink=$(pactl list short sinks | awk '{print $2}' | grep "^${prefix}" | head -1)
        if [ -n "$sink" ] && pactl set-default-sink "$sink" 2>/dev/null; then
            return 0
        fi
        sleep 0.5
    done
    return 1
}

case $MODE in
    pc)
        if [ "$SKIP_MONITORS" -eq 0 ]; then
            hyprctl keyword monitor "DP-2,preferred,5000x0,1"
            hyprctl keyword monitor "DP-1,preferred,6920x0,1"
            sleep 1
            hyprctl keyword monitor "HDMI-A-1,disable"
            hyprctl keyword monitor "DP-2,preferred,0x0,1"
            hyprctl keyword monitor "DP-1,preferred,1920x0,1"
        fi

        for ((i=1; i<=PERSISTENT_WORKSPACES; i++)); do
            hyprctl dispatch workspace $i
            if [ "$i" = 1 ]; then
                hyprctl dispatch moveworkspacetomonitor $i DP-2
            else
                hyprctl dispatch moveworkspacetomonitor $i DP-1
            fi
        done

        hyprctl dispatch focusmonitor DP-1
        hyprctl dispatch workspace 2
        hyprctl dispatch movecursor 3200 720

        set_sink "alsa_output.usb-Focusrite_Scarlett_2i2_USB-00"
        echo "pc" > "$STATE_FILE"
        notify-send -t 3000 "Display Mode" "Switched to PC"
        ;;
    tv)
        hyprctl keyword monitor "HDMI-A-1,4096x2160@60,5000x0,2"
        sleep 1
        hyprctl keyword monitor "DP-1,disable"
        hyprctl keyword monitor "DP-2,disable"
        sleep 0.5
        hyprctl keyword monitor "HDMI-A-1,4096x2160@60,0x0,2"

        for ((i=1; i<=PERSISTENT_WORKSPACES; i++)); do
            hyprctl dispatch workspace $i
            hyprctl dispatch moveworkspacetomonitor $i HDMI-A-1
        done

        hyprctl dispatch focusmonitor HDMI-A-1
        hyprctl dispatch workspace 1

        set_sink "alsa_output.pci-0000_01_00.1.hdmi"
        echo "tv" > "$STATE_FILE"
        notify-send -t 3000 "Display Mode" "Switched to TV"
        ;;
esac
