#!/bin/zsh
# sys-update — update Arch system packages and AUR
source "$HOME/.config/bash/utils.sh"

# AUR safety knobs
SOAK_DAYS=3
SOAK_EXEMPT=()
SUSPECT_RE='^\+[^+].*(npm (i|install)|bun (i|install)|pip install|base64 -d|eval |curl[^|]*\| *(ba|z)?sh|wget[^|]*\| *(ba|z)?sh)'

# Mirror freshness knob
STALE_DAYS=4

pacman_out=$(mktemp /tmp/pacman-out.XXXXXX)
keep_screen_on
trap 'rm -f "$pacman_out"; hyprctl dispatch tagwindow -- -noidle &>/dev/null || true' EXIT
section "System Update"
sudo -v

section "Syncing keyrings..."
sudo pacman -Sy --noconfirm archlinux-keyring artix-keyring >/dev/null || true

# --- Mirror freshness: a frozen mirror serves a stale db that pacman still
#     reports as "up to date". Check when the mirror last touched each .db. ---
section "Checking mirror freshness..."
arch=$(uname -m)
stale=0
for repo in system world galaxy lib32 multilib extra; do
  pacman-conf --repo "$repo" &>/dev/null || continue
  url=$(pacman-conf --repo "$repo" | awk '/^Server/{print $3; exit}')
  url=${url//\$repo/$repo}; url=${url//\$arch/$arch}
  [[ -z $url ]] && { warn "$repo: no Server configured"; continue; }
  lm=$(curl -sfLI "${url}/${repo}.db" | tr -d '\r' \
        | awk -F': ' 'tolower($1)=="last-modified"{print $2; exit}')
  if [[ -z $lm ]]; then
    warn "$repo: no Last-Modified from mirror, can't verify ($url)"
    continue
  fi
  age=$(( ( $(date +%s) - $(date -d "$lm" +%s) ) / 86400 ))
  if (( age > STALE_DAYS )); then
    warn "$repo: db is ${age}d old on $url"
    stale=1
  fi
done
if (( stale )); then
  fail "Stale mirror(s) detected. Reseat the mirrorlist before upgrading."
  exit 1
fi

# --- Auto-recovery for Artix's cross-repo soname lag ------------------------
# When a soname bump (e.g. hyprutils 12→13) lands in the priority repo (world)
# before the rebuilt consumer does, `pacman -Syu` aborts with
#   installing X breaks dependency 'libX.so=N-M' required by PKG
# because world still ships the old PKG. Arch's lower-priority `extra` repo
# usually already carries the rebuilt PKG. This parses the blocker package
# names and, if EVERY blocker has a newer version available in some repo,
# stages pinned `repo/pkg` atoms in $pins for a single retry. Returns 1 (with
# $pins emptied) on any 'cannot resolve' error, or if any blocker lacks an
# upgrade candidate — those cases stay manual.
typeset -ga pins
recover_soname_lag() {
  pins=()
  grep -q 'cannot resolve' "$pacman_out" && return 1
  local -a blockers
  blockers=("${(@f)$(grep -oE "breaks dependency '[^']+' required by [^[:space:]]+" "$pacman_out" \
      | sed 's/.*required by //' | sort -u)}")
  [[ -z ${blockers[1]} ]] && return 1
  local pkg installed best_repo best_ver repo ver
  for pkg in $blockers; do
    installed=$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')
    [[ -z $installed ]] && { pins=(); return 1; }
    best_repo="" best_ver=""
    while read -r repo ver; do
      [[ -z $repo ]] && continue
      if [[ -z $best_ver ]] || (( $(vercmp "$ver" "$best_ver") > 0 )); then
        best_ver=$ver best_repo=$repo
      fi
    done < <(pacman -Si "$pkg" 2>/dev/null | awk '/^Repository/{r=$3} /^Version/{print r, $3}')
    if [[ -n $best_ver ]] && (( $(vercmp "$best_ver" "$installed") > 0 )); then
      pins+=("$best_repo/$pkg")
    else
      pins=(); return 1
    fi
  done
  (( ${#pins} ))
}

log_before_official=$(wc -l < /var/log/pacman.log)
official_failed=0
section "Updating system packages..."
# Interactive on purpose: review the transaction for elogind/nvidia and other
# soname-transition surprises before committing. Do NOT add --noconfirm here.
sudo pacman -Syu 2>&1 | tee "$pacman_out"
first_exit=${pipestatus[1]}
if grep -qE 'cannot resolve|breaks dependency' "$pacman_out"; then
  # A dependency conflict on a rolling release is a signal, not noise.
  # One case is safely automatable: Artix's `world` shipping a soname bump
  # before the rebuilt consumer, while Arch's `extra` already has the fix.
  # recover_soname_lag detects exactly that and stages pinned repo/pkg atoms;
  # anything it can't fully resolve stays manual. The retry stays interactive
  # on purpose — the transaction now pulls from a different repo, review it.
  if recover_soname_lag; then
    warn "Cross-repo soname lag — pinning fixed builds and retrying: ${pins}"
    sudo pacman -Su "${pins[@]}" 2>&1 | tee "$pacman_out"
    retry_exit=${pipestatus[1]}
    if grep -qE 'cannot resolve|breaks dependency' "$pacman_out" || (( retry_exit != 0 )); then
      fail "Conflict persists after cross-repo retry — resolve manually."
      grep -E 'cannot resolve|breaks dependency' "$pacman_out"
      official_failed=1
    fi
  else
    fail "Dependency conflict — not auto-skipping. Resolve manually."
    grep -E 'cannot resolve|breaks dependency' "$pacman_out"
    official_failed=1
  fi
else
  (( first_exit != 0 )) && official_failed=1
fi
official_count=$(tail -n +$((log_before_official+1)) /var/log/pacman.log | grep -c '\[ALPM\] upgraded' || true)

if command -v hyprpm &>/dev/null; then
  section "Updating Hyprland plugins..."
  hyprpm update
fi

log_before_aur=$(wc -l < /var/log/pacman.log)
aur_count=0
typeset -a skip
if command -v yay &>/dev/null && pacman -Qem &>/dev/null; then
  section "Checking AUR updates..."
  pending=("${(f)$(yay -Quaq 2>/dev/null)}")
  [[ -z ${pending[1]} ]] && pending=()

  if (( ${#pending} )); then
    # --- Soak time: hold back packages modified in the last SOAK_DAYS ---
    if command -v jq &>/dev/null; then
      now=$(date +%s)
      args=$(printf 'arg[]=%s&' "${pending[@]}")
      info=$(curl -sf --max-time 10 "https://aur.archlinux.org/rpc/v5/info?${args%&}" || true)
      if [[ -n $info ]]; then
        for pkg in $pending; do
          (( ${SOAK_EXEMPT[(Ie)$pkg]} )) && continue
          mod=$(echo "$info" | jq -r --arg p "$pkg" \
            '.results[] | select(.Name==$p) | .LastModified')
          if [[ -n $mod && $mod != null ]] && (( now - mod < SOAK_DAYS * 86400 )); then
            skip+=("$pkg")
            warn "$pkg: pushed $(( (now - mod) / 3600 ))h ago, soaking (${SOAK_DAYS}d quarantine)"
          fi
        done
      else
        warn "AUR RPC unreachable, skipping soak check"
      fi
    else
      warn "jq not found, skipping soak check"
    fi

    # --- Red-flag scan: hold back suspicious PKGBUILD/install/hook changes ---
    for pkg in $pending; do
      (( ${skip[(Ie)$pkg]} )) && continue
      repo="$HOME/.cache/yay/$pkg"
      [[ -d $repo/.git ]] || continue
      git -C "$repo" fetch -q origin 2>/dev/null || continue
      if git -C "$repo" diff HEAD..FETCH_HEAD -- PKGBUILD '*.install' '*.hook' 2>/dev/null \
        | grep -qE "$SUSPECT_RE"; then
        skip+=("$pkg")
        warn "$pkg: suspicious change in PKGBUILD/install/hook, held for manual review"
        warn "    inspect with: git -C $repo diff HEAD..FETCH_HEAD"
      fi
    done

    section "Updating AUR packages..."
    if (( ${#skip} )); then
      yay -Sua --noconfirm --cleanafter --ignore "${(j:,:)skip}" || true
    else
      yay -Sua --noconfirm --cleanafter || true
    fi
    aur_count=$(tail -n +$((log_before_aur+1)) /var/log/pacman.log | grep -c '\[ALPM\] upgraded' || true)
  fi
fi

orphans=$(pacman -Qtdq 2>/dev/null || true)
if [[ -n $orphans ]]; then
  section "Removing orphans..."
  echo "$orphans"
  echo "$orphans" | sudo pacman -Rs --noconfirm -
fi

section "Rechecking updates..."
rm -f "$HOME/.cache/scripts/waybar-updates-cache"
pkill -RTMIN+8 waybar 2>/dev/null || true
check-updates
cache_file="$HOME/.cache/scripts/waybar-updates-cache"
if [[ -s "$cache_file" ]]; then
  remaining_count=$(sed 's/.*"text":"//;s/".*//' "$cache_file")
  remaining=$(sed 's/.*"tooltip":"//;s/"}[[:space:]]*$//' "$cache_file" | sed 's/\\n/\n/g')
  warn "$remaining_count package(s) still pending:"
  echo "$remaining"
else
  ok "All packages up to date"
fi

if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
  section "⚠ Kernel updated — reboot when ready!" "\e[1;33m"
fi

section "Summary"
if (( official_failed )); then
  fail "Official: update failed"
elif (( official_count > 0 )); then
  ok "Official: $official_count package(s) updated"
else
  ok "Official: already up to date"
fi
if (( aur_count > 0 )); then
  ok "AUR:      $aur_count package(s) updated"
else
  ok "AUR:      already up to date"
fi
if (( ${#skip} )); then
  warn "AUR:      ${#skip} package(s) held back: ${(j:, :)skip}"
fi
if (( official_failed )); then
  notify-send -e -u critical "Update failed."
elif (( official_count > 0 || aur_count > 0 )); then
  notify-send -e -t 2000 "Update complete."
fi

