#!/bin/zsh

# mic-pico-sync — push microphone state to the pikey macro pad's HID device so
# its LEDs reflect reality: green = mic live, red = mic muted, off = no mic.
#
# State byte written to the Pico's vendor HID output report:
#   0 = no real mic in use    -> both LEDs off
#   1 = mic in use, live       -> green
#   2 = mic in use, all muted   -> red
#
# Pushed on: startup, every PipeWire source/source-output change, and whenever
# the Pico (re)appears on USB (udev hidraw 'add') — so state stays correct
# across unplug/replug and daemon restarts.

VID=0000C0DE   # 0xc0de as it appears in HID_ID (uppercase, zero-padded)
PID=0000CAFE   # 0xcafe

# --- device discovery -------------------------------------------------------
find_hidraw() {
    local d
    for d in /sys/class/hidraw/hidraw*; do
        [[ -e $d ]] || continue
        if [[ "$(<$d/device/uevent)" == *":$VID:$PID"* ]]; then
            print -r -- "/dev/${d:t}"
            return 0
        fi
    done
    return 1
}

# --- state computation (mirrors mic-watch's "in use / muted" logic) ---------
scan_sources() {
    pactl list sources | awk '
        /^Source #/                { idx=substr($2,2); order[++n]=idx }
        /^[ \t]+Mute: /            { mute[idx]=$2 }
        /^[ \t]+Monitor of Sink: / { mon[idx]=($0 ~ /n\/a/)?"no":"yes" }
        END { for (i=1;i<=n;i++){ x=order[i];
              printf "%s\x1f%s\x1f%s\n", x, mute[x], mon[x] } }
    '
}
scan_outputs() {
    pactl list source-outputs | awk '
        /^[ \t]+Source: / { src=$2 }
        /^[ \t]+Corked: / { print src "\x1f" $2 }
    '
}

compute_state() {
    local -A s_mute s_mon
    local idx mute mon src cork
    while IFS=$'\x1f' read -r idx mute mon; do
        [[ -z $idx ]] && continue
        s_mute[$idx]=$mute; s_mon[$idx]=$mon
    done < <(scan_sources)

    local -A inuse
    while IFS=$'\x1f' read -r src cork; do
        [[ -z $src ]] && continue
        [[ $cork == yes ]] && continue          # skip paused streams
        [[ ${s_mon[$src]} == no ]] || continue  # real mic only (non-monitor)
        inuse[$src]=1
    done < <(scan_outputs)

    (( ${#inuse} == 0 )) && { print -r -- 0; return; }   # no mic in use
    for idx in ${(k)inuse}; do
        [[ ${s_mute[$idx]} == no ]] && { print -r -- 1; return; }  # any live
    done
    print -r -- 2   # in use, all muted
}

# --- push -------------------------------------------------------------------
push() {
    local dev state
    dev=$(find_hidraw) || return                    # Pico absent -> nothing to do
    state=$(compute_state)
    printf "\x00\x0$state" > "$dev" 2>/dev/null     # byte0 = report-id 0, byte1 = state
}

# --- main loop --------------------------------------------------------------
push   # initial sync

{
    pactl subscribe &
    stdbuf -oL udevadm monitor --udev --subsystem-match=hidraw &
    wait
} | while read -r line; do
    case "$line" in
        *"on source #"*|*"on source-output #"*) push ;;
        *" add "*hidraw*) sleep 0.3; push ;;   # a hidraw appeared — re-resolve & push
    esac
done

