#!/bin/zsh
# Show a fuzzy-finder TUI for picking installed packages to remove.

source "$HOME/.config/bash/utils.sh"

fzf_args=(
  --multi
  --preview 'xbps-query {1} 2>/dev/null || echo "No info available"'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:red,marker:red'
)

pkg_names=$(xbps-query -l 2>/dev/null \
  | awk '{print $2}' \
  | sed 's/-[0-9][^-]*$//' \
  | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  pkgs=(${(f)pkg_names})
  sudo xbps-remove -R "${pkgs[@]}"
  echo ""
fi
