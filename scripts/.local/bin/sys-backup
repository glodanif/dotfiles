#!/bin/zsh
# sys-backup — run restic backup to external storage, prune old snapshots
# TODO: update MOUNT_POINT and REPO before first use

set -euo pipefail
source "$HOME/.config/bash/utils.sh"

MOUNT_POINT="/mnt/backup"     # TODO: set to your backup destination mount point
REPO="/mnt/backup/restic"     # TODO: or use a cloud repo URL (s3:, b2:, etc.)
PASSWORD_FILE="/root/.restic-password"
HOSTNAME_TAG=$(hostname)

section "System Backup"
sudo -v

if ! mountpoint -q "$MOUNT_POINT"; then
    section "Mounting backup storage..."
    sudo mount "$MOUNT_POINT" || {
        warn "Failed to mount backup storage. Skipping."
        exit 0
    }
fi

section "Running backup..."
sudo restic backup --repo "$REPO" \
    --password-file "$PASSWORD_FILE" \
    --tag "$HOSTNAME_TAG" \
    --exclude "$HOME/.cache" \
    --exclude "/tmp" \
    --exclude "/var/tmp" \
    --exclude "/proc" \
    --exclude "/sys" \
    --exclude "/dev" \
    --exclude "/run" \
    "$HOME" /etc /var/lib/samba

section "Pruning old snapshots..."
sudo restic forget --repo "$REPO" \
    --password-file "$PASSWORD_FILE" \
    --host "$HOSTNAME_TAG" \
    --keep-last 5 \
    --keep-daily 7 \
    --keep-weekly 4 \
    --keep-monthly 6 \
    --prune

section "Backup complete."
