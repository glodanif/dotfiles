#!/bin/zsh
# Show a fuzzy-finder TUI for picking new AUR packages to install.

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
source "$HOME/.config/bash/utils.sh"

# Raised from 3 for the AUR outage — a first install has no history with you,
# so it deserves at least the soak sys-update applies to updates. Unlike the
# soak this only warns; you are sitting here and can read the diff.
FRESH_DAYS=14
LOW_VOTES=10
# Kept in sync with sys-update's SUSPECT_RE, minus its leading '^\+' — that one
# reads diffs, this one reads whole files.
SUSPECT_RE='(npm (i|install|x)|bun (i|install|x)|pnpm (i|install|dlx)|yarn (add|dlx)|pip install|deno (run|install)|base64 -d|eval |chmod \+[xs]|curl[^|]*\| *(ba|z)?sh|wget[^|]*\| *(ba|z)?sh)'
# Shared with sys-update, which compares against it on every run.
MAINT_DB="$HOME/.cache/scripts/aur-maintainers.json"

fzf_args=(
  --multi
  --preview 'yay -Siia {1}'
  --preview-label='alt-p: toggle description, alt-b/B: toggle PKGBUILD, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5'
  --bind 'alt-B:change-preview:yay -Siia {1}'
  --color 'pointer:green,marker:green'
)

pkg_names=$(yay -Slqa | sort -u | fzf "${fzf_args[@]}")
[[ -z $pkg_names ]] && exit 0
pkgs=(${(f)pkg_names})

# --- Pre-install vetting ---
section "Vetting ${#pkgs} package(s)..."
flags=0
now=$(date +%s)
args=$(printf 'arg[]=%s&' "${pkgs[@]}")
info=$(curl -sf "https://aur.archlinux.org/rpc/v5/info?${args%&}" || true)

vet_tmp=$(mktemp -d /tmp/aur-vet.XXXXXX)
trap 'rm -rf "$vet_tmp"' EXIT

# Fail closed on an unusable metadata source. Previously both of these left
# $flags at 0, so the run ended on "No red flags" having checked nothing —
# the one message you must never print when you did not look.
if ! command -v jq &>/dev/null; then
  warn "jq not found — no AUR metadata could be checked for any package"
  info=""; flags=1
elif [[ -z $info ]] || ! echo "$info" | jq -e '.results' &>/dev/null; then
  warn "AUR RPC unreachable — no AUR metadata could be checked for any package"
  info=""; flags=1
fi

for pkg in $pkgs; do
  if [[ -n $info ]]; then
    read -r mod votes maintainer ood < <(echo "$info" | jq -r --arg p "$pkg" \
      '.results[] | select(.Name==$p) |
       "\(.LastModified) \(.NumVotes) \(.Maintainer // "ORPHAN") \(.OutOfDate // 0)"')
    if [[ -n $mod ]]; then
      age_d=$(( (now - mod) / 86400 ))
      if (( now - mod < FRESH_DAYS * 86400 )); then
        warn "$pkg: PKGBUILD pushed $(( (now - mod) / 3600 ))h ago — fresher than ${FRESH_DAYS}d"
        flags=1
      fi
      if (( votes < LOW_VOTES )); then
        warn "$pkg: only $votes vote(s) — little community review"
        flags=1
      fi
      if [[ $maintainer == ORPHAN ]]; then
        warn "$pkg: orphaned — no active maintainer"
        flags=1
      fi
      if [[ $ood != 0 ]]; then
        warn "$pkg: flagged out-of-date since $(date -d @$ood +%F)"
        flags=1
      fi
    else
      warn "$pkg: not found in AUR RPC response"
      flags=1
    fi
  fi

  # `yay -Gpa` prints the PKGBUILD and nothing else, so the old scan never saw
  # .install files, hooks, patches, or anything binary committed alongside them
  # — precisely where the Jul 2026 technique hides. Clone the repo shallow into
  # a temp dir and read every file in the tree instead. Nothing is checked out
  # into a build path and nothing is executed.
  if git clone -q --depth 1 "https://aur.archlinux.org/$pkg.git" "$vet_tmp/$pkg" 2>/dev/null; then
    while read -r f; do
      [[ -z $f ]] && continue
      magic=$(git -C "$vet_tmp/$pkg" show "HEAD:$f" 2>/dev/null | head -c4 | od -An -tx1 | tr -d ' \n')
      if [[ $magic == 7f454c46 ]]; then
        warn "$pkg: repo ships ELF binary '$f' — a PKGBUILD repo has no reason to"
        flags=1
      fi
    done < <(git -C "$vet_tmp/$pkg" ls-tree -r --name-only HEAD)

    if grep -rqE "$SUSPECT_RE" "$vet_tmp/$pkg" --exclude-dir=.git 2>/dev/null; then
      warn "$pkg: fetch-and-execute pattern in repo files — read before confirming:"
      grep -rnE "$SUSPECT_RE" "$vet_tmp/$pkg" --exclude-dir=.git 2>/dev/null \
        | sed "s|$vet_tmp/$pkg/||; s/^/    /"
      flags=1
    fi
  else
    warn "$pkg: could not clone AUR repo — contents not inspected"
    flags=1
  fi
done

if (( flags )); then
  echo ""
  read -q "REPLY?Warnings above. Continue with install? [y/N] " || { echo ""; exit 1 }
  echo ""
else
  ok "No red flags"
fi

yay -S "${pkgs[@]}"

# Record the maintainer of whatever actually installed, so sys-update's
# handover check has a baseline for it. Without this a freshly installed
# package sits at "@unknown" and that check stays inert until its first update
# — the window in which an adopted package is most likely to push.
if [[ -n $info ]]; then
  mkdir -p "${MAINT_DB:h}"
  [[ -s $MAINT_DB ]] || echo '{}' > "$MAINT_DB"
  for pkg in $pkgs; do
    pacman -Qq "$pkg" &>/dev/null || continue
    m=$(echo "$info" | jq -r --arg p "$pkg" \
      '.results[] | select(.Name==$p) | (.Maintainer // "@orphan")')
    [[ -n $m ]] && jq --arg p "$pkg" --arg m "$m" '.[$p]=$m' "$MAINT_DB" > "$MAINT_DB.tmp" \
      && mv "$MAINT_DB.tmp" "$MAINT_DB"
  done
fi

sudo updatedb
echo ""

