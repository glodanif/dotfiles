#!/bin/zsh

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/headphones-watch"
mkdir -p "$STATE_DIR"

# Always-available sinks handled by monitors-layout-toggle. New-sink events for
# these should be ignored (matched by name prefix).
IGNORE_PREFIXES=(
    "alsa_output.usb-Focusrite_Scarlett_2i2_USB-00"
    "alsa_output.pci-0000_01_00.1.hdmi"
)

is_ignored_sink() {
    local name="$1" prefix
    for prefix in "${IGNORE_PREFIXES[@]}"; do
        [[ "$name" == "$prefix"* ]] && return 0
    done
    return 1
}

until pactl info &>/dev/null; do
    sleep 1
done

sink_name() {
    pactl -f json list sinks | jq -r --argjson idx "$1" '.[] | select(.index == $idx) | .name // empty'
}

sink_description() {
    pactl -f json list sinks | jq -r --argjson idx "$1" '.[] | select(.index == $idx) | .description // empty'
}

move_all_to_sink() {
    local name="$1"
    pactl set-default-sink "$name"
    pactl list sink-inputs short | awk '{print $1}' | while read -r input; do
        pactl move-sink-input "$input" "$name"
    done
}

# Runs in the background: shows a persistent notification offering to move
# audio to the new sink, and records the notification id so a later "remove"
# event for this sink index can dismiss it via CloseNotification.
notify_new_sink() {
    local index="$1" name="$2" description="$3"
    local id_file="$STATE_DIR/$index.id"
    local id action

    exec 3< <(notify-send -p -t 0 -a "Audio" -i "audio-card" \
        -A "move=Move audio here & set as default" \
        "New audio output detected" "${description:-$name}")

    read -r id <&3
    if [[ -z "$id" ]]; then
        exec 3<&-
        rm -f "$id_file"
        return
    fi
    echo "$id" > "$id_file"

    read -r action <&3
    exec 3<&-
    rm -f "$id_file"

    [[ "$action" == "move" ]] && move_all_to_sink "$name"
}

pactl subscribe | while read -r line; do
    if echo "$line" | grep -q "Event 'new' on sink"; then
        index=$(echo "$line" | grep -oP '#\K[0-9]+')
        id_file="$STATE_DIR/$index.id"

        [[ -e "$id_file" ]] && continue

        name=$(sink_name "$index")
        [[ -z "$name" ]] && continue
        is_ignored_sink "$name" && continue

        touch "$id_file"
        description=$(sink_description "$index")
        notify_new_sink "$index" "$name" "$description" &

    elif echo "$line" | grep -q "Event 'remove' on sink"; then
        index=$(echo "$line" | grep -oP '#\K[0-9]+')
        id_file="$STATE_DIR/$index.id"
        id=""

        for _ in {1..20}; do
            [[ -s "$id_file" ]] && { id=$(<"$id_file"); break; }
            [[ -e "$id_file" ]] || break
            sleep 0.1
        done

        [[ -n "$id" ]] && gdbus call --session \
            --dest org.freedesktop.Notifications \
            --object-path /org/freedesktop/Notifications \
            --method org.freedesktop.Notifications.CloseNotification "$id" &>/dev/null

        rm -f "$id_file"
    fi
done
