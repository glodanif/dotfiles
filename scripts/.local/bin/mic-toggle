#!/bin/zsh

# Toggle mute on the microphone(s) currently in use. If no mic is in use,
# this is a no-op (no mute change, no notification).
#
# "In use" = a non-corked recording stream (source-output) attached to a real
# input source (monitor/loopback sources are excluded).

# Emit "idx<US>name<US>ismonitor" per source.
scan_sources() {
    pactl list sources | awk '
        /^Source #/                { idx=substr($2,2); order[++n]=idx }
        /^[ \t]+Name: /            { sub(/^[ \t]+Name: /,""); name[idx]=$0 }
        /^[ \t]+Monitor of Sink: / { mon[idx]=($0 ~ /n\/a/)?"no":"yes" }
        END { for (i=1;i<=n;i++){ x=order[i];
              printf "%s\x1f%s\x1f%s\n", x, name[x], mon[x] } }
    '
}

# Emit "sourceIdx<US>corked" per recording stream.
scan_outputs() {
    pactl list source-outputs | awk '
        /^[ \t]+Source: /   { src=$2 }
        /^[ \t]+Corked: /   { print src "\x1f" $2 }
    '
}

typeset -A s_name s_mon
while IFS=$'\x1f' read -r idx nm mon; do
    [[ -z $idx ]] && continue
    s_name[$idx]=$nm; s_mon[$idx]=$mon
done < <(scan_sources)

# Collect the names of in-use real mics (deduped).
typeset -A inuse_names
while IFS=$'\x1f' read -r src cork; do
    [[ -z $src ]] && continue
    [[ $cork == yes ]] && continue
    [[ ${s_mon[$src]} == no ]] || continue
    inuse_names[${s_name[$src]}]=1
done < <(scan_outputs)

# No mic in use -> do nothing, no notification.
(( ${#inuse_names} == 0 )) && exit 0

# Target state: if any in-use mic is unmuted, mute them all; else unmute all.
# pactl set-source-mute: 1 = mute, 0 = unmute.
mute_arg=0
for name in ${(k)inuse_names}; do
    if [[ "$(pactl get-source-mute "$name" | awk '{print $2}')" == "no" ]]; then
        mute_arg=1   # at least one is live -> mute everything
        break
    fi
done

for name in ${(k)inuse_names}; do
    pactl set-source-mute "$name" "$mute_arg"
done

if (( mute_arg )); then
    notify-send -e -t 1000 "Mic muted"
else
    notify-send -e -t 1000 "Mic active"
fi
