#!/bin/zsh
source "$HOME/.config/bash/utils.sh"
section "Reboot into Windows"
# -n: passwordless via /etc/sudoers.d/reboot-into-windows; fail instead of prompting (no tty from the power menu)
sudo -n /usr/bin/efibootmgr --bootnext 0000 || exit 1
section "Done"
echo "Next reboot will launch Windows"
