#!/bin/zsh
# cookie-sync — export Brave's cookies for the download hosts and push them to the NAS.
#
# The NAS can't use a copied Brave profile: the Cookies DB is AES-encrypted with a
# key held in this machine's gnome-keyring, so a synced profile is an unreadable
# blob over there. Decrypt here instead — yt-dlp already implements Chromium's
# scheme, and copies the DB first so Brave can stay open — then ship two small
# text files:
#
#   cookies.txt         Netscape jar    -> yt-dlp --cookies
#   patreon-cookie.txt  Cookie header   -> patreon-dl --cookie
#
# Both the keyring and the ssh agent are session-scoped, so this only works while
# a graphical session is live. cron inherits neither variable, so recover them
# from the running compositor and the fixed gcr socket.

set -uo pipefail
source "$HOME/.config/bash/utils.sh"

# ── Config ────────────────────────────────────────────────
BRAVE_PROFILE="$HOME/.config/BraveSoftware/Brave-Origin/Default"
COOKIE_DIR="$HOME/.local/share/cookies"
JAR="$COOKIE_DIR/cookies.txt"
PATREON_HEADER="$COOKIE_DIR/patreon-cookie.txt"

NAS_HOST="void.local"
NAS_DIR=".local/share/cookies"

# Only the hosts the NAS actually downloads from. The jar is a bag of live
# sessions — shipping the whole browser's worth off-box would be careless.
DOMAINS="patreon.com patreonusercontent.com x.com twitter.com"

PUSH=1
QUIET=0
for arg in "$@"; do
    case "$arg" in
        --no-push)  PUSH=0 ;;
        -q|--quiet) QUIET=1 ;;
        -h|--help)  print "usage: cookie-sync [--no-push] [--quiet]"; exit 0 ;;
        *) print -u2 "cookie-sync: unknown option: $arg"; exit 2 ;;
    esac
done

# Quiet mode still reports problems — cron mails on any output, so success is
# silent and only failures land in the inbox.
say() { (( QUIET )) || "$@"; }

# ── Recover the session env (cron gives us neither) ───────
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    # No systemd user session on Artix, so there's no stable /run/user/1000/bus —
    # dbus-launch puts the socket at a random /tmp path that changes every login.
    # Read the live address back off the compositor's environment.
    hypr_pid=$(pgrep -u "$USER" -x Hyprland | head -1)
    if [[ -n "$hypr_pid" && -r "/proc/$hypr_pid/environ" ]]; then
        export DBUS_SESSION_BUS_ADDRESS=$(tr '\0' '\n' < "/proc/$hypr_pid/environ" \
            | grep -m1 '^DBUS_SESSION_BUS_ADDRESS=' | cut -d= -f2-)
    fi
fi

if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    fail "no D-Bus session bus found — the keyring is unreachable without a live session"
    exit 1
fi

if [[ -z "${SSH_AUTH_SOCK:-}" && -S "/run/user/$(id -u)/gcr/ssh" ]]; then
    export SSH_AUTH_SOCK="/run/user/$(id -u)/gcr/ssh"
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# ── Export the full jar from Brave ────────────────────────
say section "Exporting cookies from Brave"

# yt-dlp has no "just dump the cookies" mode: it writes the jar when it exits, so
# hand it a throwaway URL and ignore the inevitable "Unsupported URL" failure.
yt-dlp --cookies-from-browser "brave+gnomekeyring:$BRAVE_PROFILE" \
       --cookies "$tmp/all.txt" --skip-download --no-warnings \
       "https://example.com" >/dev/null 2>"$tmp/err"

if [[ ! -s "$tmp/all.txt" ]]; then
    fail "cookie export failed — keyring locked, or Brave profile moved"
    [[ -s "$tmp/err" ]] && sed 's/^/      /' "$tmp/err" >&2
    exit 1
fi

# ── Filter to the hosts we ship ───────────────────────────
# Netscape fields: domain flag path secure expiry name value. httponly cookies
# carry a "#HttpOnly_" domain prefix that looks like a comment — keep those lines
# and drop only real comments. Suffix matching is done with substr rather than a
# regex so the dots in "patreon.com" can't match arbitrary characters.
awk -v doms="$DOMAINS" '
    function host(d) { sub(/^#HttpOnly_/, "", d); sub(/^\./, "", d); return d }
    function wanted(dom,   i, n, m) {
        for (i = 1; i <= nd; i++) {
            n = length(dom); m = length(d[i])
            if (dom == d[i]) return 1
            if (n > m && substr(dom, n - m) == "." d[i]) return 1
        }
        return 0
    }
    BEGIN { nd = split(doms, d, " ") }
    /^#/ && !/^#HttpOnly_/ { next }
    NF >= 7 && wanted(host($1))
' "$tmp/all.txt" > "$tmp/filtered"

count=$(wc -l < "$tmp/filtered")
if (( count == 0 )); then
    fail "no cookies matched any of: $DOMAINS"
    exit 1
fi

{
    print "# Netscape HTTP Cookie File"
    print "# generated by cookie-sync on $(date -Is) — regenerated, do not edit"
    cat "$tmp/filtered"
} > "$tmp/cookies.txt"

# ── Build the Patreon Cookie header ───────────────────────
# patreon-dl wants a raw header value, not a jar. patreonusercontent.com is a
# separate site and must not leak into patreon.com's header.
patreon_hdr=$(awk '
    function host(d) { sub(/^#HttpOnly_/, "", d); sub(/^\./, "", d); return d }
    NF >= 7 {
        h = host($1)
        if (h == "patreon.com" || h ~ /\.patreon\.com$/) { printf "%s%s=%s", sep, $6, $7; sep = "; " }
    }
' "$tmp/filtered")

# session_id is the one that unlocks patron-only posts. Match the field exactly —
# analytics_session_id would satisfy a naive substring test.
has_session=$(awk '
    NF >= 7 && $6 == "session_id" {
        d = $1; sub(/^#HttpOnly_/, "", d); sub(/^\./, "", d)
        if (d == "patreon.com" || d ~ /\.patreon\.com$/) c++
    }
    END { print c + 0 }
' "$tmp/filtered")

(( has_session )) || warn "no Patreon session_id — patron-only downloads will fail (log in to Patreon in Brave)"

# ── Install locally (0600, atomic swap) ───────────────────
mkdir -p "$COOKIE_DIR"
chmod 700 "$COOKIE_DIR"

install -m 600 "$tmp/cookies.txt" "$JAR.new" && mv -f "$JAR.new" "$JAR"

umask 077
print -r -- "$patreon_hdr" > "$PATREON_HEADER.new" && mv -f "$PATREON_HEADER.new" "$PATREON_HEADER"

say ok "$count cookies exported ($DOMAINS)"

# ── Push to the NAS ───────────────────────────────────────
if (( PUSH )); then
    say section "Pushing to $NAS_HOST"
    # BatchMode so a missing agent fails fast instead of hanging on a prompt under
    # cron. A sleeping NAS is not an error here — it keeps its previous jar and
    # the next run catches it up.
    if rsync -q --chmod=F600 \
            -e "ssh -o BatchMode=yes -o ConnectTimeout=10" \
            --rsync-path="mkdir -p ~/$NAS_DIR && rsync" \
            "$JAR" "$PATREON_HEADER" "$NAS_HOST:$NAS_DIR/" 2>"$tmp/rsync.err"; then
        say ok "synced to $NAS_HOST"
    else
        warn "push to $NAS_HOST failed — it keeps its previous jar"
        [[ -s "$tmp/rsync.err" ]] && sed 's/^/      /' "$tmp/rsync.err" >&2
    fi
fi
