{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "",
    "color": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": "",
    },
    "width": null,
    "height": null,
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4,
    },
    "printRemaining": true,
    "preserveAspectRatio": false,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted",
    },
  },
  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": false,
    "disableLinewrap": true,
    "hideCursor": false,
    "separator": ": ",
    "color": {
      "keys": "",
      "title": "",
      "output": "",
      "separator": "",
    },
    "brightColor": true,
    "duration": {
      "abbreviation": false,
      "spaceBeforeUnit": "default",
    },
    "size": {
      "maxPrefix": "YB",
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default",
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91",
      },
      "spaceBeforeUnit": "default",
    },
    "percent": {
      "type": ["num", "num-color"],
      "ndigits": 0,
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91",
      },
      "spaceBeforeUnit": "default",
      "width": 0,
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "-",
      },
      "border": {
        "left": "[ ",
        "right": " ]",
        "leftElapsed": "",
        "rightElapsed": "",
      },
      "color": {
        "elapsed": "auto",
        "total": "97",
        "border": "97",
      },
      "width": 10,
    },
    "fraction": {
      "ndigits": 2,
      "trailingZeros": "default",
    },
    "noBuffer": false,
    "key": {
      "width": 0,
      "type": "string",
      "paddingLeft": 0,
    },
    "freq": {
      "ndigits": 2,
      "spaceBeforeUnit": "default",
    },
    "constants": [],
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true,
    "playerName": "",
    "dsForceDrm": false,
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": " ",
      "keyIcon": "",
      "fqdn": false,
      "color": {
        "user": "#ACC2AB",
        "at": "#FFFFFF",
        "host": "#ACC2AB",
      },
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "#fafffc",
      "times": 54,
    },
    {
      "type": "os",
      "keyIcon": "",
      "keyColor": "#ACC2AB",
    },
    {
      "type": "host",
      "keyIcon": "󰌢",
      "keyColor": "#ACC2AB",
    },
    {
      "type": "kernel",
      "keyIcon": "",
      "keyColor": "#ACC2AB",
    },
    {
      "type": "command",
      "key": "Age",
      "keyColor": "#ACC2AB",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days",
    },
    {
      "type": "uptime",
      "keyIcon": "",
      "keyColor": "#ACC2AB",
    },
    {
      "type": "localip",
      "keyIcon": "󰩟",
      "showIpv4": true,
      "showIpv6": false,
      "showMac": false,
      "showLoop": false,
      "showPrefixLen": true,
      "showMtu": false,
      "showSpeed": false,
      "showFlags": false,
      "compact": false,
      "defaultRouteOnly": false,
      "showAllIps": false,
      "namePrefix": "",
      "keyColor": "#ACC2AB",
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "#fafffc",
      "times": 54,
    },
    {
      "type": "shell",
      "keyIcon": "",
      "keyColor": "#ACC2AB",
    },
    {
      "type": "terminal",
      "keyIcon": "",
      "keyColor": "#ACC2AB",
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "#fafffc",
      "times": 54,
    },
    {
      "type": "cpu",
      "keyIcon": "",
      "temp": true,
      "showPeCoreCount": false,
      "tempSensor": "",
      "keyColor": "#ACC2AB",
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "#fafffc",
      "times": 54,
    },
    {
      "type": "memory",
      "keyIcon": "",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
      "keyColor": "#ACC2AB",
    },
    {
      "type": "swap",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
      "keyIcon": "󰓡",
      "separate": false,
      "keyColor": "#ACC2AB",
    },
    {
      "type": "disk",
      "keyIcon": "",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": true,
      "showUnknown": false,
      "folders": "",
      "hideFolders": "/efi:/boot:/boot/*",
      "hideFS": "",
      "useAvailable": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
      "keyColor": "#ACC2AB",
    },
    {
      "type": "command",
      "key": "RAID",
      "keyColor": "#ACC2AB",
      "text": "awk '/^md/{name=$1} /blocks/{print name\": \"$NF}' /proc/mdstat 2>/dev/null || echo 'none'",
    },
    {
      "type": "command",
      "key": "Load",
      "keyColor": "#ACC2AB",
      "text": "awk '{print $1\", \"$2\", \"$3}' /proc/loadavg",
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "#fafffc",
      "times": 54,
    },
    {
      "type": "colors",
      "key": " ",
      "keyIcon": "",
      "symbol": "circle",
      "paddingLeft": 0,
      "block": {
        "width": 3,
        "range": [0, 15],
      },
      "brightness": "default",
    },
  ],
}
